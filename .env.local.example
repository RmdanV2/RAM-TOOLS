# ─── OpenRouter API Keys ────────────────────────────────────────────────────
# Dapatkan key di: https://openrouter.ai/settings/keys
# JANGAN commit file .env.local ke Git — hanya .env.local.example yang boleh di-commit

# Key untuk GPT-4o (PRD generation, arsitektur)
OPENROUTER_GPT_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Key untuk Perplexity Sonar Pro (riset teknologi real-time)
OPENROUTER_SONAR_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
